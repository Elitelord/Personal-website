# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the previous rule only covered `.env*.local`, so a plain `.env`
# (which is where MAILGUN_API_KEY / MAILGUN_DOMAIN live) would have been committed
.env
.env.*
!.env.example

# vercel
.vercel

# tooling / editors
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS junk
Thumbs.db
desktop.ini

# keys & certs (*.pem already covered above)
*.key
*.p12
*.pfx
id_rsa*

# local backups & scratch
*.bak
*.orig
*~
